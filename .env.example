# OPTIONAL. Insta Deploy needs no .env: secrets are generated on first
# start, and Pangolin, the apps domain and the server address are set in
# the dashboard's setup guide. Use this file only for the cases below.
#   cp .env.example .env

# ---------------------------------------------------------------------
# Dashboard and accounts (Better Auth)
# ---------------------------------------------------------------------

# Signs login sessions. Generate one with:  openssl rand -hex 32
# (SESSION_SECRET is also accepted.) If unset, one is generated and kept
# in the frontend-data volume.
BETTER_AUTH_SECRET=

# The dashboard's public URL. Only needed behind an HTTPS reverse proxy
# (e.g. https://deploy.example.com); otherwise it's detected automatically.
BETTER_AUTH_URL=

# -----------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------

# Encrypts variables, secrets and the Pangolin API key at rest: 32 bytes,
# hex or base64 (openssl rand -hex 32). If unset, one is generated into
# the backend-data volume. Back it up: without it, stored secrets are lost.
SECRETS_KEY=

# Largest uploaded project ZIP, in MB.
MAX_UPLOAD_MB=200

# How often Git deployments with auto deploy check for new commits.
GIT_POLL_SECONDS=60

# Server settings (Pangolin, apps domain, server address for agents) are
# edited in the dashboard. Older installs can still put PANGOLIN_API_URL,
# PANGOLIN_API_KEY, PANGOLIN_ORG_ID, PANGOLIN_ENDPOINT, APPS_DOMAIN and
# PUBLIC_API_URL here: they're imported once into the dashboard settings.
